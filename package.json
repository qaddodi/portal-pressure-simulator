{
  "name": "portal-pressure-simulator",
  "version": "2.1.0",
  "description": "Interactive, physics-based simulator of the portal circulation for medical education.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs . 8080",
    "test": "node --test --test-concurrency=4 tests/*.test.js",
    "lint": "eslint .",
    "stamp": "node scripts/stamp.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist 8081",
    "smoke": "node tests/e2e/smoke.mjs",
    "smoke:dist": "node tests/e2e/smoke.mjs dist",
    "smoke:webkit": "node tests/e2e/words-steady.mjs",
    "smoke:idle": "node tests/e2e/idle-steady.mjs",
    "smoke:veins": "node tests/e2e/veins-gesture.mjs",
    "smoke:rows": "node tests/e2e/veins-rows.mjs && node tests/e2e/veins-stale.mjs",
    "smoke:widths": "node tests/e2e/width-equiv.mjs",
    "smoke:draws": "node tests/e2e/figure-draws.mjs",
    "smoke:gesture": "node tests/e2e/pinch-pan.mjs",
    "smoke:frame": "node tests/e2e/frame-centre.mjs",
    "smoke:card": "node tests/e2e/text-card.mjs",
    "smoke:quick": "node tests/e2e/quick.mjs",
    "perf": "node scripts/perf.mjs",
    "perf:frames": "node scripts/frame-cost.mjs",
    "perf:dive": "node scripts/perf-dive.mjs",
    "perf:zoom": "node scripts/zoom-even.mjs",
    "check": "npm run lint && npm test && npm run build && npm run smoke && npm run smoke:dist",
    "scorm": "node scripts/scorm.mjs",
    "visual": "node tests/e2e/visual.mjs",
    "smoke:order": "node tests/e2e/card-order.mjs",
    "smoke:credit": "node tests/e2e/credit-steady.mjs",
    "smoke:layers": "node tests/e2e/plate-layers.mjs",
    "smoke:shapes": "node tests/e2e/shape-cover.mjs",
    "smoke:pool": "node tests/e2e/fluid-pool.mjs",
    "smoke:paint": "node tests/e2e/organ-paint.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "^1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
