{
  "name": "portal-pressure-simulator",
  "version": "2.1.0",
  "description": "Interactive, physics-based simulator of the portal circulation for medical education.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs . 8080",
    "test": "node --test --test-concurrency=4 tests/*.test.js",
    "lint": "eslint . && node scripts/off-gpu-scan.mjs && node scripts/rules-lint.mjs && node scripts/gen-theme-css.mjs --check",
    "typecheck": "npx --yes -p typescript@5.6.3 tsc -p jsconfig.json",
    "offgpu": "node scripts/off-gpu-scan.mjs --doc",
    "warm": "node --expose-gc --max-semi-space-size=128 scripts/warm-alloc.mjs",
    "stamp": "node scripts/stamp.mjs",
    "gen:theme": "node scripts/gen-theme-css.mjs",
    "check:theme": "node scripts/gen-theme-css.mjs --check",
    "gen:stops": "node scripts/gen-stop-tokens.mjs",
    "check:stops": "node scripts/gen-stop-tokens.mjs --check",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist 8081",
    "smoke": "node tests/e2e/smoke.mjs",
    "smoke:dist": "node tests/e2e/smoke.mjs dist",
    "smoke:webkit": "node tests/e2e/words-steady.mjs",
    "smoke:idle": "node tests/e2e/idle-steady.mjs",
    "smoke:veins": "node tests/e2e/veins-gesture.mjs",
    "smoke:rows": "node tests/e2e/veins-rows.mjs && node tests/e2e/veins-stale.mjs",
    "smoke:menu": "node tests/e2e/menu-kept.mjs",
    "smoke:widths": "node tests/e2e/width-equiv.mjs",
    "smoke:draws": "node tests/e2e/figure-draws.mjs",
    "smoke:gesture": "node tests/e2e/pinch-pan.mjs",
    "smoke:labels": "node tests/e2e/label-follow.mjs",
    "smoke:frame": "node tests/e2e/frame-centre.mjs",
    "smoke:card": "node tests/e2e/text-card.mjs",
    "smoke:words": "node tests/e2e/gl-words-keep.mjs",
    "smoke:classes": "node tests/e2e/gl-classes.mjs",
    "smoke:gate-labels": "node tests/e2e/label-gate.mjs",
    "smoke:gate-labels:webkit": "ENGINE=webkit node tests/e2e/label-gate.mjs",
    "smoke:leaders": "node tests/e2e/circuit-leaders.mjs",
    "smoke:cards-labels": "node tests/e2e/labels-off-cards.mjs",
    "smoke:quick": "node tests/e2e/quick.mjs",
    "gate": "node scripts/gate.mjs",
    "gate:full": "node scripts/gate.mjs --full",
    "gate:motion": "node scripts/gate.mjs --only static,motion",
    "perf": "node scripts/perf.mjs",
    "perf:frames": "node scripts/frame-cost.mjs",
    "perf:gate": "node scripts/frame-gate.mjs",
    "perf:dive": "node scripts/perf-dive.mjs",
    "perf:zoom": "node scripts/zoom-even.mjs",
    "check": "npm run lint && npm test && npm run build && npm run check:static",
    "check:static": "node scripts/check-static.mjs",
    "smoke:lite": "node scripts/smoke-lite.mjs",
    "scorm": "node scripts/scorm.mjs",
    "visual": "node tests/e2e/visual.mjs",
    "smoke:order": "node tests/e2e/card-order.mjs",
    "smoke:credit": "node tests/e2e/credit-steady.mjs",
    "smoke:layers": "node tests/e2e/plate-layers.mjs",
    "smoke:shapes": "node tests/e2e/shape-cover.mjs",
    "smoke:pool": "node tests/e2e/fluid-pool.mjs",
    "smoke:paint": "node tests/e2e/organ-paint.mjs",
    "smoke:diaphragm": "node tests/e2e/diaphragm.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
